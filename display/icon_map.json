{
  "_comment": "Rules are checked in order; first match wins. 'match' is AND — all keywords must appear in the lowercased condition string. 'night_icon' is used when is_night=True; falls back to 'icon' if absent.",
  "rules": [
    {"match": ["tornado"],                               "icon": "wi-tornado.bmp"},
    {"match": ["hurricane"],                             "icon": "wi-hurricane.bmp"},
    {"match": ["typhoon"],                               "icon": "wi-hurricane.bmp"},
    {"match": ["blizzard"],                              "icon": "wi-snow-wind.bmp"},
    {"match": ["snow", "thunderstorm"],                  "icon": "wi-day-snow-thunderstorm.bmp",   "night_icon": "wi-night-snow-thunderstorm.bmp"},
    {"match": ["snow", "tstm"],                          "icon": "wi-day-snow-thunderstorm.bmp",   "night_icon": "wi-night-snow-thunderstorm.bmp"},
    {"match": ["snow", "lightning"],                     "icon": "wi-day-snow-thunderstorm.bmp",   "night_icon": "wi-night-snow-thunderstorm.bmp"},
    {"match": ["sleet", "storm"],                        "icon": "wi-day-sleet-storm.bmp",         "night_icon": "wi-night-sleet-storm.bmp"},
    {"match": ["thunderstorm", "shower"],                "icon": "wi-day-storm-showers.bmp",       "night_icon": "wi-night-storm-showers.bmp"},
    {"match": ["thunderstorm"],                          "icon": "wi-thunderstorm.bmp"},
    {"match": ["tstm"],                                  "icon": "wi-thunderstorm.bmp"},
    {"match": ["lightning"],                             "icon": "wi-thunderstorm.bmp"},
    {"match": ["freezing rain"],                         "icon": "wi-sleet.bmp"},
    {"match": ["fzra"],                                  "icon": "wi-sleet.bmp"},
    {"match": ["freezing drizzle"],                      "icon": "wi-sleet.bmp"},
    {"match": ["sleet"],                                 "icon": "wi-sleet.bmp"},
    {"match": ["ice pellet"],                            "icon": "wi-sleet.bmp"},
    {"match": ["hail"],                                  "icon": "wi-hail.bmp"},
    {"match": ["blowing snow"],                          "icon": "wi-snow-wind.bmp"},
    {"match": ["drifting snow"],                         "icon": "wi-snow-wind.bmp"},
    {"match": ["snow", "wind"],                          "icon": "wi-snow-wind.bmp"},
    {"match": ["snow"],                                  "icon": "wi-snow.bmp"},
    {"match": ["wintry mix"],                            "icon": "wi-rain-mix.bmp"},
    {"match": ["rain and snow"],                         "icon": "wi-rain-mix.bmp"},
    {"match": ["snow and rain"],                         "icon": "wi-rain-mix.bmp"},
    {"match": ["rain/snow"],                             "icon": "wi-rain-mix.bmp"},
    {"match": ["shower"],                                "icon": "wi-day-showers.bmp",             "night_icon": "wi-night-showers.bmp"},
    {"match": ["drizzle"],                               "icon": "wi-day-sprinkle.bmp",            "night_icon": "wi-night-sprinkle.bmp"},
    {"match": ["sprinkle"],                              "icon": "wi-day-sprinkle.bmp",            "night_icon": "wi-night-sprinkle.bmp"},
    {"match": ["rain"],                                  "icon": "wi-rain.bmp"},
    {"match": ["rainy"],                                 "icon": "wi-rain.bmp"},
    {"match": ["fog"],                                   "icon": "wi-fog.bmp"},
    {"match": ["mist"],                                  "icon": "wi-fog.bmp"},
    {"match": ["haze"],                                  "icon": "wi-day-haze.bmp",                "night_icon": "wi-night-fog.bmp"},
    {"match": ["smoke"],                                 "icon": "wi-smoke.bmp"},
    {"match": ["dust"],                                  "icon": "wi-dust.bmp"},
    {"match": ["sand"],                                  "icon": "wi-dust.bmp"},
    {"match": ["windy"],                                 "icon": "wi-day-windy.bmp",               "night_icon": "wi-night-cloudy.bmp"},
    {"match": ["breezy"],                                "icon": "wi-day-windy.bmp",               "night_icon": "wi-night-cloudy.bmp"},
    {"match": ["gusty"],                                 "icon": "wi-day-windy.bmp",               "night_icon": "wi-night-cloudy.bmp"},
    {"match": ["overcast"],                              "icon": "wi-cloudy.bmp"},
    {"match": ["mostly cloudy"],                         "icon": "wi-day-cloudy.bmp",              "night_icon": "wi-night-cloudy.bmp"},
    {"match": ["partly cloudy"],                         "icon": "wi-day-sunny-overcast.bmp",      "night_icon": "wi-night-partly-cloudy.bmp"},
    {"match": ["partly sunny"],                          "icon": "wi-day-sunny-overcast.bmp",      "night_icon": "wi-night-partly-cloudy.bmp"},
    {"match": ["mostly sunny"],                          "icon": "wi-day-cloudy-high.bmp",         "night_icon": "wi-night-cloudy-high.bmp"},
    {"match": ["sunny"],                                 "icon": "wi-day-sunny.bmp",               "night_icon": "wi-night-clear.bmp"},
    {"match": ["clear"],                                 "icon": "wi-day-sunny.bmp",               "night_icon": "wi-night-clear.bmp"},
    {"match": ["hot"],                                   "icon": "wi-hot.bmp"},
    {"match": ["cold"],                                  "icon": "wi-snowflake-cold.bmp"},
    {"match": ["frigid"],                                "icon": "wi-snowflake-cold.bmp"},
    {"match": ["freeze"],                                "icon": "wi-snowflake-cold.bmp"},
    {"match": ["cloudy"],                                "icon": "wi-cloudy.bmp"}
  ],
  "fallback": "wi-cloud.bmp"
}
